# ─────────────────────────────────────────────────────────────────────────────
# API Gateway — Environment Variables
# Copy this file to .env and fill in your real values.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
# Local dev: points to the Docker container on port 5433
# Docker Compose: uses service name "postgres" (override in docker-compose.yml)
DATABASE_URL="postgresql://admin:password123@localhost:5433/rootedmemories?schema=public"

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET="change-me-to-a-strong-random-secret-in-production"

# ── Server ────────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ── Stripe ────────────────────────────────────────────────────────────────────
# Get keys from https://dashboard.stripe.com/apikeys
# Leave empty to run in MOCK MODE (no real payment processing)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ── AWS S3 ────────────────────────────────────────────────────────────────────
# Leave empty to run in MOCK MODE (uploads stored as base64 locally)
# Fill in real values to enable direct-to-S3 presigned URL uploads
AWS_REGION="ap-south-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_S3_BUCKET_NAME="vector-assets-prod-storage"
